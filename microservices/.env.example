# ============================================================
# Kissan Mithar Consultancy — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── App ────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── Security ───────────────────────────
JWT_SECRET=change_this_super_secret_minimum_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_minimum_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Redis ──────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# ─── RabbitMQ ───────────────────────────
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=admin
RABBITMQ_PASS=your_rabbitmq_password

# ─── Supabase (PostgreSQL) ──────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_key

# ─── MongoDB ────────────────────────────
MONGODB_URI=mongodb://localhost:27017/kissanmithar

# ─── Cloudinary ─────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Razorpay ───────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret

# ─── AI APIs ────────────────────────────
GEMINI_API_KEY=your_gemini_key
PLANT_ID_API_KEY=your_plant_id_key

# ─── SMS ────────────────────────────────
ENABLE_SMS=false
FAST2SMS_API_KEY=your_fast2sms_key

# ─── Email ──────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
ADMIN_EMAIL=admin@kissanmithar.com
ADMIN_PHONE=+91XXXXXXXXXX

# ─── Market Data ────────────────────────
DATA_GOV_API_KEY=your_data_gov_key

# ─── Frontend ───────────────────────────
REACT_APP_API_URL=http://localhost
REACT_APP_SHOW_DEV_LOGIN=true
REACT_APP_ENV=development

# ─── Service Ports ──────────────────────
AUTH_PORT=3001
USER_PORT=3002
AI_PORT=3003
DISEASE_PORT=3004
SOIL_PORT=3005
MARKET_PORT=3006
ECOMMERCE_PORT=3007
ORDER_PORT=3008
PAYMENT_PORT=3009
NOTIFICATION_PORT=3010
SUPPORT_PORT=3011
EXPERT_PORT=3012
CONTENT_PORT=3013
ANALYTICS_PORT=3014
FIELD_PORT=3015
