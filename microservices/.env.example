# ═══════════════════════════════════════════════════════════
# KISSAN MITHAR CONSULTANCY — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file:  cp .env.example .env
# Fill in your values below.
#
# REQUIRED fields are marked — the app won't start without them.
# OPTIONAL fields have sensible defaults for local development.
# ═══════════════════════════════════════════════════════════

# ─── App Settings ────────────────────────────────────────
# Options: development | production | test
NODE_ENV="production"
# Log verbosity: error | warn | info | debug
LOG_LEVEL=debug
# Default port (overridden per-service in docker-compose.yml)
PORT=4000

# ─── API Gateway (Nginx) ────────────────────────────────
NGINX_PORT=80
NGINX_SSL_PORT=443

# ─── Service Ports ──────────────────────────────────────
# Each microservice runs on a unique port.
# These are mapped in docker-compose.yml.
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
AI_SERVICE_PORT=3003
DISEASE_SERVICE_PORT=3004
SOIL_SERVICE_PORT=3005
MARKET_SERVICE_PORT=3006
ECOMMERCE_SERVICE_PORT=3007
ORDER_SERVICE_PORT=3008
PAYMENT_SERVICE_PORT=3009
NOTIFICATION_SERVICE_PORT=3010
SUPPORT_SERVICE_PORT=3011
EXPERT_SERVICE_PORT=3012
CONTENT_SERVICE_PORT=3013
ANALYTICS_SERVICE_PORT=3014
FIELD_SERVICE_PORT=3015

# ─── JWT Authentication ─────────────────────────────────
# REQUIRED: Used to sign and verify JWT tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_random_32_char_string"
JWT_REFRESH_SECRET="CHANGE_ME_generate_a_different_random_string"
# Token expiry durations
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Supabase (PostgreSQL) ──────────────────────────────
# REQUIRED: Your Supabase project URL and service role key.
# Get from: https://supabase.com → Project → Settings → API
SUPABASE_REST_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# ⚠️ NEVER expose SERVICE_ROLE_KEY in frontend code!

# ─── MongoDB ────────────────────────────────────────────
# REQUIRED: MongoDB Atlas connection string.
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI="mongodb+srv://username:password@cluster.example.mongodb.net"

# ─── Redis (Caching & Sessions) ─────────────────────────
# Password for the Redis instance running in Docker
REDIS_PASSWORD="kmc_redis_secret"
# Redis URL — uses Docker service name 'redis' inside containers
# Inside Docker:  redis://:kmc_redis_secret@redis:6379
# Outside Docker: redis://:kmc_redis_secret@localhost:6379
REDIS_URL=redis://:kmc_redis_secret@localhost:6379

# ─── RabbitMQ (Message Broker) ──────────────────────────
# REQUIRED: RabbitMQ connection URL.
# For CloudAMQP: amqps://user:pass@host/vhost
# For local Docker: amqp://user:pass@rabbitmq:5672/kissan
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/kissan
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── Cloudinary (Image & File Storage) ──────────────────
# REQUIRED for: disease scan uploads, product images, profile photos
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ─── Google Gemini AI ───────────────────────────────────
# REQUIRED for: AI-powered disease detection and soil analysis
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ─── Groq AI (Optional fallback) ────────────────────────
# Optional: Used as AI fallback when Gemini is unavailable
GROQ_API_KEY="your_groq_api_key_here"

# ─── Plant.id API ───────────────────────────────────────
# REQUIRED for: Plant disease identification fallback
# Get from: https://plant.id → API
PLANT_ID_API_KEY="your_plant_id_api_key"
PLANT_ID_API_URL="https://plant.id/api/v3"

# ─── Razorpay (Payments) ────────────────────────────────
# REQUIRED for: Order payments, refunds
# Get from: https://razorpay.com → Settings → API Keys
# Use test keys (rzp_test_*) for development
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"
# Webhook URL: https://yourdomain.com/api/payments/webhook

# ─── Fast2SMS (OTP Delivery) ────────────────────────────
# REQUIRED for production. In dev, set ENABLE_SMS=false.
ENABLE_SMS=false
# false = OTP shown in API response body (development)
# true  = OTP sent via SMS to farmer's phone (production)
FAST2SMS_API_KEY="your_fast2sms_api_key"

# ─── Email (Brevo / Nodemailer) ─────────────────────────
# REQUIRED for: Transactional emails (order confirmations, etc.)
# Brevo (formerly Sendinblue): https://app.brevo.com → SMTP & API
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER="your_brevo_smtp_login"
EMAIL_PASS="your_brevo_smtp_password"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PHONE=+919000000000

# ─── data.gov.in (Mandi Market Prices) ──────────────────
# REQUIRED for: Real-time mandi price data
# Get free key: https://data.gov.in → Register → API Keys
DATA_GOV_API_KEY="your_data_gov_api_key"
DATA_GOV_RESOURCE_ID=

# ─── OpenWeather API ────────────────────────────────────
# Optional: Weather data for farmer dashboard
# Get free key: https://openweathermap.org/api (1000 calls/day)
OPENWEATHER_API_KEY=your_openweather_key

# ─── Frontend ───────────────────────────────────────────
# URL that the React frontend uses to call the API
# Points to Nginx gateway, NOT directly to services
REACT_APP_API_URL=http://localhost
# Show quick-login buttons on frontend (dev only!)
REACT_APP_SHOW_DEV_LOGIN=true
# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ─── Monitoring (Prometheus + Grafana) ──────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=choose_a_strong_password
GRAFANA_SECRET_KEY=generate_a_random_secret_here