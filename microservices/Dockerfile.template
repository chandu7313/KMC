# ─── Stage 1: Dependencies ───────────────
FROM node:18-alpine AS dependencies
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY packages/ ./packages/

# Install production dependencies only
RUN npm ci --only=production
# Copy installed packages
RUN cp -R node_modules /tmp/prod_modules

# Install all deps (including dev)
RUN npm ci

# ─── Stage 2: Development ────────────────
FROM node:18-alpine AS development
WORKDIR /app

# Install dev tools
RUN apk add --no-cache curl

# Copy deps from previous stage
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/packages ./packages

# Copy source
COPY src ./src
COPY package*.json ./

# Create logs directory
RUN mkdir -p logs

# Expose port (build arg)
ARG PORT=3001
ENV PORT=$PORT
EXPOSE $PORT

# Health check
HEALTHCHECK --interval=30s --timeout=10s \
  --start-period=40s --retries=3 \
  CMD curl -f http://localhost:$PORT/health || exit 1

# Run with nodemon for hot reload
CMD ["node_modules/.bin/nodemon", "src/index.js"]

# ─── Stage 3: Builder ────────────────────
FROM node:18-alpine AS builder
WORKDIR /app

COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/packages ./packages
COPY src ./src
COPY package*.json ./

# Any build steps (TypeScript compile, etc)
# RUN npm run build

# ─── Stage 4: Production ─────────────────
FROM node:18-alpine AS production
WORKDIR /app

# Security: non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nodeuser -u 1001

# Install only curl for healthcheck
RUN apk add --no-cache curl

# Copy only production node_modules
COPY --from=dependencies /tmp/prod_modules ./node_modules
COPY --from=dependencies /app/packages ./packages
COPY --from=builder /app/src ./src
COPY package*.json ./

# Create logs dir with correct permissions
RUN mkdir -p logs && chown -R nodeuser:nodejs logs

# Switch to non-root
USER nodeuser

ARG PORT=3001
ENV PORT=$PORT
ENV NODE_ENV=production

EXPOSE $PORT

HEALTHCHECK --interval=30s --timeout=10s \
  --start-period=40s --retries=3 \
  CMD curl -f http://localhost:$PORT/health || exit 1

CMD ["node", "src/index.js"]
