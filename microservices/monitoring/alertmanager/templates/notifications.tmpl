{{ define "email.html" }}
<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; background: #f5f5f5; margin: 0; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .header { padding: 20px; color: white; text-align: center; }
    .header-firing { background: linear-gradient(135deg, #e74c3c, #c0392b); }
    .header-resolved { background: linear-gradient(135deg, #27ae60, #2ecc71); }
    .body { padding: 20px; }
    .alert-card { border: 1px solid #eee; border-radius: 6px; padding: 15px; margin: 10px 0; background: #fafafa; }
    .label { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 12px; margin: 2px; background: #3498db; color: white; }
    .severity-critical { background: #e74c3c; }
    .severity-warning { background: #f39c12; }
    .severity-info { background: #3498db; }
    .footer { padding: 15px; text-align: center; color: #999; font-size: 12px; border-top: 1px solid #eee; }
    h2 { margin: 0; }
    .meta { color: #666; font-size: 13px; margin-top: 5px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header {{ if eq .Status "firing" }}header-firing{{ else }}header-resolved{{ end }}">
      <h2>🌾 Kissan Mithar — {{ .Status | toUpper }}</h2>
      <p class="meta">{{ .Alerts | len }} alert(s)</p>
    </div>
    <div class="body">
      {{ range .Alerts }}
      <div class="alert-card">
        <strong>{{ .Labels.alertname }}</strong>
        <span class="label severity-{{ .Labels.severity }}">{{ .Labels.severity }}</span>
        {{ if .Labels.service }}<span class="label">{{ .Labels.service }}</span>{{ end }}
        <p>{{ .Annotations.summary }}</p>
        <p style="color: #666; font-size: 13px;">{{ .Annotations.description }}</p>
        <p class="meta">Started: {{ .StartsAt.Format "2006-01-02 15:04:05 MST" }}</p>
        {{ if .Annotations.runbook }}<p class="meta">📖 {{ .Annotations.runbook }}</p>{{ end }}
      </div>
      {{ end }}
    </div>
    <div class="footer">
      Kissan Mithar Consultancy — Monitoring System<br/>
      <a href="http://localhost:3100">Grafana</a> |
      <a href="http://localhost:9090">Prometheus</a> |
      <a href="http://localhost:9093">AlertManager</a>
    </div>
  </div>
</body>
</html>
{{ end }}

{{ define "email.critical.html" }}
<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; background: #f5f5f5; margin: 0; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.15); border-top: 4px solid #e74c3c; }
    .header { padding: 20px; background: linear-gradient(135deg, #e74c3c, #c0392b); color: white; text-align: center; }
    .body { padding: 20px; }
    .alert-card { border: 2px solid #e74c3c; border-radius: 6px; padding: 15px; margin: 10px 0; background: #fff5f5; }
    .footer { padding: 15px; text-align: center; color: #999; font-size: 12px; border-top: 1px solid #eee; }
    h2 { margin: 0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>🚨 CRITICAL ALERT — Kissan Mithar</h2>
      <p>Immediate attention required!</p>
    </div>
    <div class="body">
      {{ range .Alerts }}
      <div class="alert-card">
        <h3 style="color: #e74c3c; margin-top: 0;">{{ .Annotations.summary }}</h3>
        <p>{{ .Annotations.description }}</p>
        <p style="font-size: 13px; color: #666;">Service: <strong>{{ .Labels.service }}</strong></p>
        <p style="font-size: 13px; color: #666;">Started: {{ .StartsAt.Format "2006-01-02 15:04:05 MST" }}</p>
        {{ if .Annotations.runbook }}<p style="font-size: 13px;">📖 Runbook: {{ .Annotations.runbook }}</p>{{ end }}
      </div>
      {{ end }}
    </div>
    <div class="footer">
      Kissan Mithar Consultancy — Critical Alert System
    </div>
  </div>
</body>
</html>
{{ end }}
