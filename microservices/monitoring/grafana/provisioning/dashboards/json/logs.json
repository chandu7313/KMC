{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "title": "📊 Log Volume", "type": "row" },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 10 }] } } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 }, "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Errors (1h)", "type": "stat",
      "targets": [{ "expr": "count_over_time({level=\"error\"}[1h])", "refId": "A" }]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "yellow", "value": null }] } } },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 }, "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Warnings (1h)", "type": "stat",
      "targets": [{ "expr": "count_over_time({level=\"warn\"}[1h])", "refId": "A" }]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 }, "id": 3,
      "title": "Log Volume by Level", "type": "timeseries",
      "targets": [
        { "expr": "sum(count_over_time({service=~\"$service\", level=\"error\"}[5m]))", "legendFormat": "error" },
        { "expr": "sum(count_over_time({service=~\"$service\", level=\"warn\"}[5m]))", "legendFormat": "warn" },
        { "expr": "sum(count_over_time({service=~\"$service\", level=\"info\"}[5m]))", "legendFormat": "info" }
      ]
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "id": 101, "title": "📝 Log Explorer", "type": "row" },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 10 }, "id": 4,
      "options": { "showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "sortOrder": "Descending" },
      "title": "Logs", "type": "logs",
      "targets": [{ "expr": "{service=~\"$service\"} |~ \"$search\" | level=~\"$level\"", "refId": "A" }]
    }
  ],
  "refresh": "30s", "schemaVersion": 38, "style": "dark",
  "tags": ["kissan-mithar", "logs"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(service)",
        "includeAll": true,
        "name": "service",
        "query": "label_values(service)",
        "refresh": 2, "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "includeAll": true,
        "name": "level",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "text": "error", "value": "error" },
          { "text": "warn", "value": "warn" },
          { "text": "info", "value": "info" }
        ],
        "type": "custom"
      },
      {
        "current": { "text": "", "value": "" },
        "name": "search",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "Asia/Kolkata",
  "title": "📝 Logs Explorer",
  "uid": "kissan-logs", "version": 1
}
