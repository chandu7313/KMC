  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "title": "💰 Revenue & Orders", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyINR", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 }, "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Revenue Today (₹)", "type": "stat",
      "targets": [{ "expr": "sum(increase(kissan_revenue_total_rupees[24h])) or vector(0)" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
