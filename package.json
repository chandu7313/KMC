{
  "name": "kissan-mithar",
  "private": true,
  "workspaces": [
    "packages/*",
    "microservices/*",
    "services/*",
    "frontend/*"
  ],
  "scripts": {
    "dev": "docker-compose up",
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:all": "concurrently \"npm run dev:auth\"",
    "test": "jest --projects services/*/jest.config.js",
    "test:coverage": "jest --coverage",
    "lint": "eslint services/**/src/**/*.js",
    "build": "docker-compose -f docker-compose.prod.yml build",
    "seed": "node scripts/seedDevAccounts.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0"
  }
}
